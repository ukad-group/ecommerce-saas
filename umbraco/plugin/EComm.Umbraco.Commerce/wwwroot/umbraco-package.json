{
  "$schema": "../../umbraco-package-schema.json",
  "name": "EComm Commerce",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "section",
      "alias": "ecomm.section.commerce",
      "name": "Commerce Admin",
      "weight": 200,
      "meta": {
        "label": "EComm Commerce",
        "pathname": "e-commerce"
      }
    },
    {
      "type": "dashboard",
      "alias": "ecomm.dashboard.commerce.orders",
      "name": "Commerce Orders Dashboard",
      "element": "/App_Plugins/ECommCommerce/components/commerce-admin/commerce-admin-dashboard.js",
      "weight": 100,
      "meta": {
        "label": "Orders",
        "pathname": "orders"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "ecomm.section.commerce"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "ecomm.commerce.settings",
      "name": "Commerce Settings",
      "element": "/App_Plugins/ECommCommerce/components/settings/settings-dashboard.js",
      "weight": 100,
      "meta": {
        "label": "Commerce Settings",
        "pathname": "commerce-settings"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "propertyEditorUi",
      "alias": "EComm.PropertyEditorUi.CategoryPicker",
      "name": "Commerce Category Picker",
      "element": "/App_Plugins/ECommCommerce/components/propertyEditors/category-picker.js",
      "meta": {
        "label": "Category Picker",
        "icon": "icon-folder",
        "group": "ecomm-commerce",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "EComm.PropertyEditorUi.StorePicker",
      "name": "Commerce Store Picker",
      "element": "/App_Plugins/ECommCommerce/components/propertyEditors/store-picker.js",
      "meta": {
        "label": "Store Picker",
        "icon": "icon-shopping-basket",
        "group": "ecomm-commerce",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "EComm.PropertyEditorUi.ProductPicker",
      "name": "Commerce Product Picker",
      "element": "/App_Plugins/ECommCommerce/components/propertyEditors/product-picker.js",
      "meta": {
        "label": "Product Picker",
        "icon": "icon-box",
        "group": "ecomm-commerce",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String"
      }
    },
    {
      "type": "condition",
      "alias": "EComm.Condition.IsProductPage",
      "name": "eCommerce: Is Product Page",
      "api": "/App_Plugins/ECommCommerce/components/conditions/is-product-page.condition.js"
    },
    {
      "type": "workspaceView",
      "alias": "ecomm.workspaceView.products",
      "name": "eCommerce Products View",
      "element": "/App_Plugins/ECommCommerce/components/workspaceViews/products-workspace-view.js",
      "weight": -200,
      "meta": {
        "label": "eCommerce",
        "pathname": "ecommerce",
        "icon": "icon-shopping-basket"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Document"
        },
        {
          "alias": "EComm.Condition.IsProductPage"
        }
      ]
    }
  ]
}
