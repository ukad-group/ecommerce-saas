@* Nullable: the shopper can land here with no pending order cookie (expired, or a direct hit). *@
@model EComm.Commerce.Demo.Models.OrderDto?
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Payment Failed";
}

<div class="container my-5">
    <div class="text-center mb-4">
        <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center bg-danger rounded-circle"
                  style="width:80px;height:80px;">
                <i class="bi bi-exclamation-triangle text-white" style="font-size:2.5rem;"></i>
            </span>
        </div>
        <h1 class="display-6 fw-bold text-danger">Payment failed</h1>
        <p class="lead text-muted">
            We couldn't complete your payment. Nothing has been charged.
        </p>
        @if (Model != null)
        {
            <div class="badge bg-secondary fs-6 px-4 py-2">Order #@Model.OrderNumber</div>
        }
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <p class="text-muted">
                This can happen if the card was declined or the payment session expired.
                You can try again with the same basket.
            </p>
            <div class="d-flex gap-2 justify-content-center">
                <a href="/checkout" class="btn btn-primary">
                    <i class="bi bi-arrow-clockwise me-1"></i>Try again
                </a>
                <a href="/cart" class="btn btn-outline-secondary">Back to cart</a>
            </div>
        </div>
    </div>
</div>
