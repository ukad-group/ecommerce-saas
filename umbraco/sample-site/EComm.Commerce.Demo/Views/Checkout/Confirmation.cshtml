@model EComm.Commerce.Demo.Models.OrderDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Order Confirmed";
}

<div class="container my-5">
    <!-- Success Banner -->
    <div class="text-center mb-5">
        <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center bg-success rounded-circle"
                  style="width:80px;height:80px;">
                <i class="bi bi-check-lg text-white" style="font-size:2.5rem;"></i>
            </span>
        </div>
        <h1 class="display-5 fw-bold text-success">Order Confirmed!</h1>
        <p class="lead text-muted">
            Thank you for your purchase. Your order has been placed successfully.
        </p>
        <div class="badge bg-primary fs-6 px-4 py-2">Order #@Model.OrderNumber</div>
        @if (!string.IsNullOrEmpty(Model.TrackingNumber))
        {
            <div class="mt-2">
                <span class="badge bg-secondary px-3 py-2">
                    <i class="bi bi-box-seam me-1"></i>Tracking: @Model.TrackingNumber
                </span>
            </div>
        }
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Order Details -->
        <div class="col-lg-8">

            <!-- Order Items -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-bag me-2 text-primary"></i>Order Items</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.Items)
                        {
                            <li class="list-group-item d-flex align-items-center gap-3 py-3 px-4">
                                <div class="flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                    {
                                        <img src="@item.ProductImageUrl" alt="@item.ProductName"
                                             class="rounded" style="width:60px;height:60px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                             style="width:60px;height:60px;">
                                            <i class="bi bi-box text-muted fs-4"></i>
                                        </div>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@item.ProductName</div>
                                    @if (!string.IsNullOrEmpty(item.Sku))
                                    {
                                        <small class="text-muted">SKU: @item.Sku</small>
                                    }
                                    <div class="text-muted small">
                                        @item.Quantity × £@item.UnitPrice.ToString("N2")
                                    </div>
                                </div>
                                <div class="fw-semibold text-end">
                                    £@item.Subtotal.ToString("N2")
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between mb-1 text-muted">
                        <span>Subtotal</span>
                        <span>£@Model.Subtotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 text-muted">
                        <span>Shipping</span>
                        <span class="text-success">Free</span>
                    </div>
                    @if (Model.Tax > 0)
                    {
                        <div class="d-flex justify-content-between mb-1 text-muted">
                            <span>Tax</span>
                            <span>£@Model.Tax.ToString("N2")</span>
                        </div>
                    }
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total Paid</span>
                        <span class="text-primary">£@Model.Total.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Customer & Delivery Info -->
            <div class="row g-3 mb-4">
                @if (Model.Customer != null)
                {
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-white">
                                <h6 class="mb-0"><i class="bi bi-person me-2 text-primary"></i>Customer</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-1 fw-semibold">@Model.Customer.FullName</p>
                                <p class="mb-1 text-muted small">
                                    <i class="bi bi-envelope me-1"></i>@Model.Customer.Email
                                </p>
                                @if (!string.IsNullOrEmpty(Model.Customer.Phone))
                                {
                                    <p class="mb-0 text-muted small">
                                        <i class="bi bi-telephone me-1"></i>@Model.Customer.Phone
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                }
                @if (Model.ShippingAddress != null)
                {
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-white">
                                <h6 class="mb-0"><i class="bi bi-truck me-2 text-primary"></i>Shipping Address</h6>
                            </div>
                            <div class="card-body">
                                <address class="mb-0 small">
                                    @Model.ShippingAddress.Street<br />
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Street2))
                                    {
                                        @Model.ShippingAddress.Street2<br />
                                    }
                                    @Model.ShippingAddress.City, @Model.ShippingAddress.State<br />
                                    @Model.ShippingAddress.PostalCode<br />
                                    @Model.ShippingAddress.Country
                                </address>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- What happens next -->
            <div class="card shadow-sm mb-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>What happens next?</h6>
                    <div class="row g-3">
                        <div class="col-md-4 text-center">
                            <div class="mb-2"><i class="bi bi-envelope-check fs-2 text-primary"></i></div>
                            <div class="small fw-semibold">Confirmation Email</div>
                            <div class="text-muted" style="font-size:0.8rem">Sent to @(Model.Customer?.Email ?? "your email")</div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="mb-2"><i class="bi bi-box-seam fs-2 text-primary"></i></div>
                            <div class="small fw-semibold">Processing</div>
                            <div class="text-muted" style="font-size:0.8rem">Order being prepared for dispatch</div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="mb-2"><i class="bi bi-truck fs-2 text-primary"></i></div>
                            <div class="small fw-semibold">Delivery</div>
                            <div class="text-muted" style="font-size:0.8rem">Estimated 3–5 business days</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <a href="/" class="btn btn-primary btn-lg">
                    <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
