@model EComm.Commerce.Demo.Models.CartDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Your Cart";
}

<div class="container my-5">
    <h1 class="mb-4"><i class="bi bi-cart3"></i> Your Cart</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <p class="text-muted">Browse our products and add something you like!</p>
            <a href="/" class="btn btn-primary mt-2">
                <i class="bi bi-arrow-left me-2"></i>Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4" style="width:80px">Image</th>
                                    <th>Product</th>
                                    <th class="text-center" style="width:150px">Quantity</th>
                                    <th class="text-end" style="width:120px">Price</th>
                                    <th class="text-end pe-4" style="width:120px">Subtotal</th>
                                    <th style="width:50px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4 align-middle">
                                            @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                            {
                                                <img src="@item.ProductImageUrl" alt="@item.ProductName"
                                                     class="rounded" style="width:64px;height:64px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                     style="width:64px;height:64px;">
                                                    <i class="bi bi-box text-muted fs-4"></i>
                                                </div>
                                            }
                                        </td>
                                        <td class="align-middle">
                                            <div class="fw-semibold">@item.ProductName</div>
                                            <small class="text-muted">£@item.UnitPrice.ToString("N2") each</small>
                                        </td>
                                        <td class="align-middle">
                                            <form asp-action="Update" asp-controller="Cart" method="post" class="d-flex align-items-center gap-2 justify-content-center">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemId" value="@item.Id" />
                                                <button type="submit" name="quantity" value="@(item.Quantity - 1)"
                                                        class="btn btn-outline-secondary btn-sm px-2">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <span class="fw-semibold" style="min-width:24px;text-align:center">@item.Quantity</span>
                                                <button type="submit" name="quantity"
                                                        value="@(item.Quantity + 1)"
                                                        class="btn btn-outline-secondary btn-sm px-2"
                                                        @(item.AvailableStock.HasValue && item.Quantity >= item.AvailableStock ? "disabled" : "")>
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </form>
                                            @if (item.AvailableStock.HasValue)
                                            {
                                                <div class="text-center">
                                                    <small class="text-muted">@item.AvailableStock in stock</small>
                                                </div>
                                            }
                                        </td>
                                        <td class="align-middle text-end">£@item.UnitPrice.ToString("N2")</td>
                                        <td class="align-middle text-end pe-4 fw-semibold">£@item.Subtotal.ToString("N2")</td>
                                        <td class="align-middle text-center">
                                            <form asp-action="Remove" asp-controller="Cart" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-link text-danger p-0"
                                                        title="Remove item"
                                                        onclick="return confirm('Remove this item from cart?')">
                                                    <i class="bi bi-trash fs-5"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal (@Model.Items.Count item@(Model.Items.Count == 1 ? "" : "s"))</span>
                            <span>£@Model.Subtotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping</span>
                            <span class="text-success">Free</span>
                        </div>
                        @if (Model.Tax > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tax</span>
                                <span>£@Model.Tax.ToString("N2")</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span class="text-primary">£@Model.Total.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-grid">
                            <a href="/checkout" class="btn btn-primary btn-lg">
                                <i class="bi bi-lock me-2"></i>Proceed to Checkout
                            </a>
                        </div>
                        <div class="text-center mt-3">
                            <small class="text-muted">
                                <i class="bi bi-shield-check me-1"></i>Secure checkout
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Trust badges -->
                <div class="card mt-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-truck text-primary me-3 fs-5"></i>
                            <div>
                                <div class="fw-semibold small">Free Shipping</div>
                                <div class="text-muted" style="font-size:0.8rem">On all orders</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-arrow-clockwise text-primary me-3 fs-5"></i>
                            <div>
                                <div class="fw-semibold small">30-Day Returns</div>
                                <div class="text-muted" style="font-size:0.8rem">Hassle-free returns</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-shield-check text-primary me-3 fs-5"></i>
                            <div>
                                <div class="fw-semibold small">Secure Payment</div>
                                <div class="text-muted" style="font-size:0.8rem">SSL encrypted</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
