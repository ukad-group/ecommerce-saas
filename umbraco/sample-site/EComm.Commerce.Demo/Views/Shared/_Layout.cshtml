<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Demo Shop</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-3" href="/" aria-label="Demo Shop">
                    <span class="brand-mark" aria-hidden="true">
                        <img src="/assets/branding/ukad-logo-blue.svg" alt="UKAD logo" />
                    </span>
                    <span class="brand-text">
                        <span class="brand-title">Demo Shop</span>
                        <span class="brand-tag">Built by UKAD | Powered by Umbraco</span>
                    </span>
                </a>
                <div class="ms-auto">
                    <a href="/cart" class="btn btn-outline-light position-relative" aria-label="View cart">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span id="cartBadge"
                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                              style="display:none;font-size:0.65rem;">0</span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light mt-5 py-4">
        <div class="container">
            <p class="text-muted mb-0">&copy; 2025 Demo Shop</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Show cart count from cookie
        (function () {
            function getCookie(name) {
                var value = '; ' + document.cookie;
                var parts = value.split('; ' + name + '=');
                if (parts.length === 2) return parts.pop().split(';').shift();
            }
            var count = parseInt(getCookie('ecomm_cart_count') || '0', 10);
            var badge = document.getElementById('cartBadge');
            if (badge && count > 0) {
                badge.textContent = count;
                badge.style.display = '';
            }
        })();

        // Toast notification helper used by Add to Cart
        function showCartToast(message, type) {
            var container = document.getElementById('toastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toastContainer';
                container.className = 'position-fixed bottom-0 end-0 p-3';
                container.style.zIndex = '1100';
                document.body.appendChild(container);
            }
            var id = 'toast-' + Date.now();
            var bg = type === 'error' ? 'bg-danger' : 'bg-success';
            var icon = type === 'error' ? 'bi-exclamation-circle' : 'bi-cart-check';
            container.insertAdjacentHTML('beforeend',
                '<div id="' + id + '" class="toast align-items-center text-white ' + bg + ' border-0 show" role="alert">' +
                '  <div class="d-flex">' +
                '    <div class="toast-body"><i class="bi ' + icon + ' me-2"></i>' + message + '</div>' +
                '    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>' +
                '  </div>' +
                '</div>'
            );
            setTimeout(function () {
                var el = document.getElementById(id);
                if (el) el.remove();
            }, 3500);
        }

        // Update cart badge count
        function updateCartBadge(count) {
            var badge = document.getElementById('cartBadge');
            if (!badge) return;
            if (count > 0) {
                badge.textContent = count;
                badge.style.display = '';
            } else {
                badge.style.display = 'none';
            }
            // Also update the cookie so it persists
            document.cookie = 'ecomm_cart_count=' + count + '; path=/; max-age=' + (90 * 86400) + '; SameSite=Lax';
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
