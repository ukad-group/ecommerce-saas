@using EComm.Commerce.Demo.Controllers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ProductPageViewModel>
@inject EComm.Umbraco.Commerce.Services.IProductImageUrlHelper ProductImages
@{
    Layout = "master.cshtml";
    ViewData["Title"] = Model.Product?.Name ?? "Product";
}

<div class="container my-4">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        </div>
    }
    else if (Model.Product == null)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Product not found.
        </div>
    }
    else
    {
        var product = Model.Product;
        var hasVariants = product.HasVariants && product.Variants != null && product.Variants.Any();
        var defaultVariant = hasVariants ? product.Variants.FirstOrDefault(v => v.IsDefault) ?? product.Variants.First() : null;
        var hasStock = hasVariants ? (defaultVariant?.StockQuantity ?? 0) > 0 : (product.StockQuantity ?? 0) > 0;

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                
                @if (Model.CategoryBreadcrumbs != null && Model.CategoryBreadcrumbs.Any())
                {
                    @* Use breadcrumb trail from content tree *@
                    @foreach (var crumb in Model.CategoryBreadcrumbs)
                    {
                        <li class="breadcrumb-item">
                            <a href="@crumb.Url">@crumb.Name</a>
                        </li>
                    }
                }
                else if (Model.Category != null)
                {
                    @* Fallback to simple parent category link *@
                    <li class="breadcrumb-item">
                        <a href="@Model.Parent?.Url()">@Model.Category.Name</a>
                    </li>
                }
                
                <li class="breadcrumb-item active" aria-current="page">@product.Name</li>
            </ol>
        </nav>

        <div class="row">
            <!-- Product Images -->
            <div class="col-md-6">
                @{
                    var productImages = product.Images != null && product.Images.Any()
                        ? product.Images.ToList()
                        : new List<EComm.Umbraco.Commerce.Models.ProductImage> { "https://via.placeholder.com/600x400?text=" + Uri.EscapeDataString(product.Name ?? "Product") };
                    var mainImage = productImages.First();
                    Func<EComm.Umbraco.Commerce.Models.FocalPoint, string> focalStyle = fp =>
                        fp == null ? "" : $"object-position:{(fp.Left * 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}% {(fp.Top * 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";
                }

                <!-- Main Image -->
                <div class="card mb-3">
                    <img id="mainImage"
                         src="@ProductImages.CropUrl(mainImage)"
                         class="card-img-top"
                         alt="@(mainImage.AltText ?? product.Name)"
                         style="max-height: 500px; object-fit: contain;">
                </div>

                <!-- Thumbnail Gallery -->
                @if (productImages.Count > 1)
                {
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var image in productImages)
                        {
                            var cropped = ProductImages.CropUrl(image);
                            <img src="@cropped"
                                 alt="@(image.AltText ?? $"{product.Name} thumbnail")"
                                 class="img-thumbnail"
                                 style="width: 80px; height: 80px; object-fit: cover; cursor: pointer; @focalStyle(image.FocalPoint)"
                                 onclick="document.getElementById('mainImage').src='@cropped'" />
                        }
                    </div>
                }

                <!-- Custom Properties -->
                @if (product.CustomProperties != null && product.CustomProperties.Any())
                {
                    <div class="card mt-3">
                        <div class="card-body">
                            <h5 class="card-title">Specifications</h5>
                            <ul class="list-unstyled mb-0">
                                @foreach (var property in product.CustomProperties)
                                {
                                    <li class="mb-2">
                                        <strong>@property.Name:</strong> @property.Value
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>

            <!-- Product Details -->
            <div class="col-md-6">
                <h1 class="display-5 fw-bold">@product.Name</h1>

                @if (Model.Category != null)
                {
                    <p class="text-muted">
                        <i class="bi bi-tag"></i>
                        <a href="@Model.Parent?.Url()">@Model.Category.Name</a>
                    </p>
                }

                <!-- Variant Selection -->
                @if (hasVariants && product.VariantOptions != null)
                {
                    <div class="variant-selection mb-4">
                        @foreach (var option in product.VariantOptions)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">@option.Name:</label>
                                <div class="btn-group d-flex gap-2 flex-wrap" role="group" aria-label="@option.Name selection">
                                    @foreach (var value in option.Values)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-primary variant-option flex-fill"
                                                data-option-name="@option.Name"
                                                data-option-value="@value">
                                            @value
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Price -->
                <div class="my-3">
                    @if (hasVariants && defaultVariant != null)
                    {
                        <span id="variantPrice" class="display-6 text-primary fw-bold">
                            @if (defaultVariant.SalePrice.HasValue)
                            {
                                <span class="text-decoration-line-through text-muted me-2">£@defaultVariant.Price.ToString("N2")</span>
                                <span>£@defaultVariant.SalePrice.Value.ToString("N2")</span>
                            }
                            else
                            {
                                <span>£@defaultVariant.Price.ToString("N2")</span>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="display-6 text-primary fw-bold">£@((product.Price ?? 0).ToString("N2"))</span>
                    }
                </div>

                <!-- Stock Status -->
                <div class="mb-3">
                    @if (hasVariants && defaultVariant != null)
                    {
                        <span id="variantStock">
                            @if (defaultVariant.StockQuantity > 0)
                            {
                                <span class="badge bg-success fs-6">
                                    <i class="bi bi-check-circle"></i> In Stock (@defaultVariant.StockQuantity available)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">
                                    <i class="bi bi-x-circle"></i> Out of Stock
                                </span>
                            }
                        </span>
                    }
                    else if (hasStock)
                    {
                        <span class="badge bg-success fs-6">
                            <i class="bi bi-check-circle"></i> In Stock (@product.StockQuantity available)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">
                            <i class="bi bi-x-circle"></i> Out of Stock
                        </span>
                    }
                </div>

                <!-- Description -->
                @if (!string.IsNullOrEmpty(product.Description))
                {
                    <div class="mb-4">
                        <h5>Description</h5>
                        <p class="lead">@product.Description</p>
                    </div>
                }

                <!-- Product Info -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Product Information</h5>
                        <ul class="list-unstyled mb-0">
                            <li><strong>Product ID:</strong> @product.Id</li>
                            @if (!string.IsNullOrEmpty(product.CategoryId))
                            {
                                <li><strong>Category ID:</strong> @product.CategoryId</li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Product Add-ons -->
                @{
                    var optionBlocks = (product.Options ?? new List<EComm.Umbraco.Commerce.Models.ProductOption>())
                        .Where(b => !b.Disabled && b.OptionIds.Any(id => Model.OptionPresets.ContainsKey(id)))
                        .ToList();

                    // Prefer the rich Umbraco-Media image (focal-point cropped); fall back to the legacy URL.
                    Func<EComm.Umbraco.Commerce.Models.OptionPreset, string> addonImgSrc = o =>
                        o.Image != null ? ProductImages.CropUrl(o.Image) : o.ImageUrl;

                    // Renders one purchasable single option as an add row (shared by
                    // standalone singles and the sub-options of a group).
                    Func<dynamic, object> renderAddonRow = @<text>
                        @{ var opt = (EComm.Umbraco.Commerce.Models.OptionPreset)item; var inStock = opt.StockQuantity > 0; }
                        <div class="addon-row d-flex align-items-center gap-2 py-2">
                            @{ var optSrc = addonImgSrc(opt); }
                            @if (!string.IsNullOrEmpty(optSrc))
                            {
                                <img src="@optSrc" alt="@(opt.Image?.AltText ?? opt.Name)" class="rounded"
                                     style="width:48px;height:48px;object-fit:cover;" />
                            }
                            <div class="flex-grow-1">
                                <span class="d-block"><i class="bi bi-tag text-muted me-1"></i>@opt.Name</span>
                                @if (!string.IsNullOrEmpty(opt.Description))
                                {
                                    <small class="text-muted">@opt.Description</small>
                                }
                            </div>
                            <span class="fw-bold text-primary">+£@opt.Price.ToString("N2")</span>
                            @if (inStock)
                            {
                                <button class="btn btn-outline-primary btn-sm btn-add-addon"
                                        data-product-id="@product.Id"
                                        data-option-id="@opt.Id">
                                    <i class="bi bi-cart-plus"></i> Add
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-sm" disabled>
                                    <i class="bi bi-x-circle"></i> Out of Stock
                                </button>
                            }
                        </div>
                    </text>;
                }
                @if (optionBlocks.Any())
                {
                    <div class="card mt-4 mb-4">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Add-ons</h5>
                        </div>
                        <div class="card-body p-0">
                            @foreach (var block in optionBlocks)
                            {
                                <div class="addon-block border-bottom p-3">
                                    <strong class="d-block">@block.Title</strong>
                                    @if (!string.IsNullOrEmpty(block.Description))
                                    {
                                        <small class="text-muted d-block mb-2">@block.Description</small>
                                    }

                                    @foreach (var optId in block.OptionIds)
                                    {
                                        if (!Model.OptionPresets.TryGetValue(optId, out var opt) || opt.Status != "active")
                                        {
                                            continue;
                                        }

                                        if (opt.Kind == "group")
                                        {
                                            <div class="addon-group ps-2 border-start">
                                                <div class="d-flex align-items-center gap-2 mt-2">
                                                    @{ var grpSrc = addonImgSrc(opt); }
                                                    @if (!string.IsNullOrEmpty(grpSrc))
                                                    {
                                                        <img src="@grpSrc" alt="@(opt.Image?.AltText ?? opt.Name)" class="rounded"
                                                             style="width:40px;height:40px;object-fit:cover;" />
                                                    }
                                                    <div>
                                                        <span class="d-block fw-semibold">
                                                            <i class="bi bi-collection text-primary me-1"></i>@opt.Name
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(opt.Description))
                                                        {
                                                            <small class="text-muted">@opt.Description</small>
                                                        }
                                                    </div>
                                                </div>
                                                @foreach (var subId in opt.SubOptionIds ?? new List<string>())
                                                {
                                                    if (!Model.OptionPresets.TryGetValue(subId, out var sub)
                                                        || sub.Status != "active" || sub.Kind == "group")
                                                    {
                                                        continue;
                                                    }
                                                    @renderAddonRow(sub)
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            @renderAddonRow(opt)
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Actions -->
                <div class="d-grid gap-2">
                    @if (hasStock)
                    {
                        <button class="btn btn-primary btn-lg btn-add-to-cart"
                                data-product-id="@product.Id"
                                data-has-variants="@(hasVariants ? "true" : "false")">
                            <i class="bi bi-cart-plus"></i> Add to Cart
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg btn-add-to-cart" disabled>
                            <i class="bi bi-x-circle"></i> Out of Stock
                        </button>
                    }
                    <a href="@Model.Parent?.Url()" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to @Model.Category?.Name
                    </a>
                </div>
            </div>
        </div>

        <!-- Features -->
        <div class="row mt-5">
            <div class="col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-truck fs-1 text-primary"></i>
                        <h5 class="card-title mt-3">Free Shipping</h5>
                        <p class="card-text text-muted">On orders over £50</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-shield-check fs-1 text-primary"></i>
                        <h5 class="card-title mt-3">Secure Payment</h5>
                        <p class="card-text text-muted">100% secure transactions</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-arrow-clockwise fs-1 text-primary"></i>
                        <h5 class="card-title mt-3">Easy Returns</h5>
                        <p class="card-text text-muted">30-day return policy</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Add to Cart handler -->
        <script>
        (function() {
            var addBtn = document.querySelector('.btn-add-to-cart');
            if (!addBtn || addBtn.disabled) return;

            addBtn.addEventListener('click', async function() {
                var productId = this.getAttribute('data-product-id');
                var hasVariants = this.getAttribute('data-has-variants') === 'true';
                var variantId = null;

                if (hasVariants) {
                    // Find selected variant from selectedOptions (set by variant JS below)
                    var sv = window.selectedOptions || {};
                    if (Object.keys(sv).length > 0 && window.variants) {
                        var match = window.variants.find(function(v) {
                            var opts = v.options || {};
                            return Object.entries(sv).every(function(e) { return opts[e[0]] === e[1]; });
                        });
                        if (match) variantId = match.id;
                    }
                }

                addBtn.disabled = true;
                addBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Adding...';

                try {
                    var res = await fetch('/cart/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: productId, variantId: variantId, quantity: 1 })
                    });

                    if (res.ok) {
                        var data = await res.json();
                        if (typeof updateCartBadge === 'function') updateCartBadge(data.cartItemCount);
                        if (typeof showCartToast === 'function') showCartToast('Added to cart!', 'success');
                    } else {
                        var err = await res.text();
                        if (typeof showCartToast === 'function') showCartToast(err || 'Could not add to cart', 'error');
                    }
                } catch (e) {
                    if (typeof showCartToast === 'function') showCartToast('Network error. Please try again.', 'error');
                } finally {
                    addBtn.disabled = false;
                    addBtn.innerHTML = '<i class="bi bi-cart-plus"></i> Add to Cart';
                }
            });
        })();
        </script>

        @if (Model.OptionPresets.Count > 0)
        {
            <script>
            (function () {
                // Add-to-cart handler for each add-on (store-global option preset)
                document.querySelectorAll('.btn-add-addon').forEach(function (btn) {
                    btn.addEventListener('click', async function () {
                        var productId = this.dataset.productId;
                        var optionId = this.dataset.optionId;

                        btn.disabled = true;
                        var origHtml = btn.innerHTML;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Adding...';

                        try {
                            var res = await fetch('/cart/add', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ productId: productId, optionId: optionId, quantity: 1 })
                            });
                            if (res.ok) {
                                var data = await res.json();
                                if (typeof updateCartBadge === 'function') updateCartBadge(data.cartItemCount);
                                if (typeof showCartToast === 'function') showCartToast('Add-on added to cart!', 'success');
                            } else {
                                var err = await res.text();
                                if (typeof showCartToast === 'function') showCartToast(err || 'Could not add to cart', 'error');
                            }
                        } catch (e) {
                            if (typeof showCartToast === 'function') showCartToast('Network error. Please try again.', 'error');
                        } finally {
                            btn.disabled = false;
                            btn.innerHTML = origHtml;
                        }
                    });
                });
            })();
            </script>
        }

        @if (hasVariants && product.Variants != null)
        {
            var variantJsonOptions = new System.Text.Json.JsonSerializerOptions
            {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            };

            <!-- Variant Selection JavaScript -->
            <script>
                // Product variants data (exposed globally for Add to Cart)
                window.variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(product.Variants, variantJsonOptions));
                window.selectedOptions = {};
                const variants = window.variants;
                const selectedOptions = window.selectedOptions;

                // Initialize with default variant options
                @if (defaultVariant != null)
                {
                    foreach (var kvp in defaultVariant.Options)
                    {
                        <text>selectedOptions['@kvp.Key'] = '@kvp.Value';</text>
                    }
                }

                // Highlight default variant buttons
                document.addEventListener('DOMContentLoaded', function() {
                    Object.entries(selectedOptions).forEach(([optionName, optionValue]) => {
                        const button = document.querySelector(
                            `.variant-option[data-option-name="${optionName}"][data-option-value="${optionValue}"]`
                        );
                        if (button) {
                            button.classList.remove('btn-outline-primary');
                            button.classList.add('btn-primary');
                        }
                    });
                });

                // Handle variant option selection
                document.querySelectorAll('.variant-option').forEach(button => {
                    button.addEventListener('click', function() {
                        const optionName = this.getAttribute('data-option-name');
                        const optionValue = this.getAttribute('data-option-value');

                        // Update selected options
                        selectedOptions[optionName] = optionValue;

                        // Update button states for this option group
                        document.querySelectorAll(`.variant-option[data-option-name="${optionName}"]`).forEach(btn => {
                            btn.classList.remove('btn-primary');
                            btn.classList.add('btn-outline-primary');
                        });
                        this.classList.remove('btn-outline-primary');
                        this.classList.add('btn-primary');

                        // Find matching variant
                        updateVariantDisplay();
                    });
                });

                function updateVariantDisplay() {
                    // Find variant that matches all selected options
                    const matchingVariant = variants.find(variant => {
                        const options = variant.options || {};
                        return Object.entries(selectedOptions).every(([key, value]) => {
                            return options[key] === value;
                        });
                    });

                    if (!matchingVariant) {
                        console.warn('No matching variant found for:', selectedOptions);
                        return;
                    }

                    // Update price
                    const priceElement = document.getElementById('variantPrice');
                    if (priceElement) {
                        if (matchingVariant.salePrice) {
                            priceElement.innerHTML = `
                                <span class="text-decoration-line-through text-muted me-2">£${matchingVariant.price.toFixed(2)}</span>
                                <span>£${matchingVariant.salePrice.toFixed(2)}</span>
                            `;
                        } else {
                            priceElement.innerHTML = `<span>£${matchingVariant.price.toFixed(2)}</span>`;
                        }
                    }

                    // Update stock
                    const stockElement = document.getElementById('variantStock');
                    if (stockElement) {
                        if (matchingVariant.stockQuantity > 0) {
                            stockElement.innerHTML = `
                                <span class="badge bg-success fs-6">
                                    <i class="bi bi-check-circle"></i> In Stock (${matchingVariant.stockQuantity} available)
                                </span>
                            `;
                        } else {
                            stockElement.innerHTML = `
                                <span class="badge bg-danger fs-6">
                                    <i class="bi bi-x-circle"></i> Out of Stock
                                </span>
                            `;
                        }
                    }

                    // Update "Add to Cart" button
                    const addToCartBtn = document.querySelector('.btn-add-to-cart');
                    if (addToCartBtn) {
                        if (matchingVariant.stockQuantity > 0) {
                            addToCartBtn.disabled = false;
                            addToCartBtn.classList.remove('btn-secondary');
                            addToCartBtn.classList.add('btn-primary');
                            addToCartBtn.innerHTML = '<i class="bi bi-cart-plus"></i> Add to Cart';
                        } else {
                            addToCartBtn.disabled = true;
                            addToCartBtn.classList.remove('btn-primary');
                            addToCartBtn.classList.add('btn-secondary');
                            addToCartBtn.innerHTML = '<i class="bi bi-x-circle"></i> Out of Stock';
                        }
                    }

                    // Update main image if variant has custom images
                    if (matchingVariant.images && matchingVariant.images.length > 0) {
                        const mainImageElement = document.getElementById('mainImage');
                        if (mainImageElement) {
                            mainImageElement.src = matchingVariant.images[0];
                        }
                    }
                }
            </script>
        }
    }
</div>
