{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Memory": {
      "Capacity": 1000,
      "LogLevel": {
        "Default": "Information",
        "EComm.Payment": "Debug",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ecomm.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://127.0.0.1:5173"
    ]
  },
  "Payments": {
    "PublicBaseUrl": ""
  },
  "Jwt": {
    "SecretKey": "eComm-Super-Secret-Key-For-Development-Only-Change-In-Production-Min32Chars",
    "Issuer": "eComm-API",
    "Audience": "eComm-Frontend",
    "ExpiryMinutes": 60
  }
}
